# --- Backend FastAPI (login JWT, registros OCR por HTTP) ---
# URL sin barra final. El cliente debe poder alcanzarla al arrancar la app.
API_BASE_URL=http://127.0.0.1:8000

# Rutas relativas a API_BASE_URL (deben empezar por /)
LOGIN_ENDPOINT=/auth/login
REGISTROS_ENDPOINT=/registros/
COVERTURAS_ENDPOINT=/coverages/
ENVIOS_PX_ENDPOINT=/shipments-px/
RECEIVERS_ENDPOINT=/receivers/
ADDRESSES_ENDPOINT=/addresses/
CONTACTS_ENDPOINT=/contacts/
TITLES_ENDPOINT=/titles/
JOB_ROLES_ENDPOINT=/job-roles/
ORGANIZATIONS_ENDPOINT=/organizations/
VOLANTES_ENDPOINT=/volante/
SEPOMEX_ENDPOINT=/sepomex/

# Timeout del cliente HTTP hacia FastAPI (login, CRUD, catálogos)
API_TIMEOUT_SECONDS=60

# Clave API de OpenAI (obligatorio para enviar a IA)
OPENAI_API_KEY=sk-...

# Modelo (por defecto gpt-6-luna, no cambiar desde la UI)
OPENAI_MODEL=gpt-6-luna

# Timeout en segundos para llamadas a OpenAI
TIMEOUT_SECONDS=60

# Carpeta destino para exportaciones CSV/Excel
# (si aplica; el diálogo suele usar Descargas del usuario)
EXPORT_DIR=downloads
